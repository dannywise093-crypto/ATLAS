# OpenAI-compatible inference service base URL, including /v1.
# Example shape: https://your-inference-host.example/v1
ATLAS_UPSTREAM_BASE_URL=
ATLAS_MODEL_ID=

# Optional provider credential. Keep this only in the private backend environment.
ATLAS_UPSTREAM_API_KEY=

# Required in deployed environments. Render Blueprint generates this secret.
# For local development only, it may be left blank.
ATLAS_GATEWAY_TOKEN=

# Local browser origins are for direct development only.
# Production web requests use Cloudflare Pages Functions and the Worker.
ATLAS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ATLAS_UPSTREAM_TIMEOUT_SECONDS=45
