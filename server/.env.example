# OpenAI-compatible inference endpoint. Examples include a local llama.cpp
# server, vLLM, or a hosted endpoint that supports /v1/chat/completions.
ATLAS_UPSTREAM_BASE_URL=http://127.0.0.1:1234/v1
ATLAS_MODEL_ID=local-model

# Optional. Keep this only on the server; never add it to VITE_ variables.
ATLAS_UPSTREAM_API_KEY=

# Comma-separated browser origins allowed to call this gateway.
ATLAS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ATLAS_UPSTREAM_TIMEOUT_SECONDS=90
