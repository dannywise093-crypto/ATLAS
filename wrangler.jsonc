{
  "$schema": "node_modules/wrangler/config-schema.json",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-11-14",
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "KNOWLEDGE_DB",
      "database_name": "atlas-knowledge-archive",
      "database_id": "27a086e4-c14b-4822-9d47-267f68163773",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "NEXORA_RESEARCH",
      "service": "nexora-deep-researcher"
    }
  ],
  "name": "atlas-coding-chat"
}
