{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas-model-gateway",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "browser": {
    "binding": "BROWSER"
  }
}
